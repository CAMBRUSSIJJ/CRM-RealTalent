# RealTalent CRM — CR10 Supabase Staging Bootstrap
# Nunca commit real secrets. Use um projeto Supabase EXCLUSIVO de staging/homologação.

# Supabase CLI / remote project
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
CR10_PROJECT_REF=

# API keys do projeto de staging
CR10_SUPABASE_URL=https://SEU-PROJETO.supabase.co
CR10_SUPABASE_PUBLISHABLE_KEY=
# Somente para o bootstrap server-side/terminal. NUNCA usar no frontend.
CR10_SUPABASE_SERVICE_ROLE_KEY=

# Workspace e contas sintéticas de staging
CR10_WORKSPACE_NAME=RealTalent CRM Staging CR10
CR10_ADMIN_EMAIL=admin-cr10@example.com
CR10_ADMIN_PASSWORD=troque-esta-senha-forte
CR10_MANAGER_EMAIL=manager-cr10@example.com
CR10_MANAGER_PASSWORD=troque-esta-senha-forte
CR10_SELLER_EMAIL=seller-cr10@example.com
CR10_SELLER_PASSWORD=troque-esta-senha-forte

# Mudanças remotas exigem confirmação explícita.
CR10_APPLY_MIGRATIONS=NO
CR10_PUSH_CONFIG=NO
CR10_DEPLOY_FUNCTIONS=NO
