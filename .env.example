# RealTalent CRM — copie para .env.local e preencha somente o necessário.
VITE_APP_NAME=RealTalent CRM

# local: dados somente no navegador | supabase: banco compartilhado | auto: detecta pela configuração
VITE_DATA_MODE=local

# Obrigatório quando VITE_DATA_MODE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Metadados de publicação
VITE_RELEASE_CHANNEL=development
VITE_COMMIT_SHA=local

# Segredos de integrações e workers nunca pertencem ao frontend.
# Configure-os no Supabase usando supabase/functions/.env.example como referência.
