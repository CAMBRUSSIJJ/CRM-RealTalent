# RealTalent CRM — Vercel / Production
# Nunca versionar credenciais reais.
NODE_ENV=production
VITE_APP_ENV=production
VITE_DATA_MODE=supabase
VITE_PUBLIC_APP_URL=https://crm.seudominio.com
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUBSTITUA_PELA_CHAVE_PUBLICAVEL

# Browser: use proxies same-origin. Não coloque tokens privados em VITE_*.
VITE_AGENT_GATEWAY_URL=/api/runtime/agent
VITE_COMMUNICATIONS_GATEWAY_URL=/api/runtime/communications
VITE_PROSPECTING_GATEWAY_URL=/api/runtime/prospecting
# Opcional: RealTalent Connect precisa ser serviço persistente com HTTPS/WSS; deixe vazio para usar discador externo.
VITE_REALTALENT_CONNECT_URL=
# Opcional: telas administrativas separadas
VITE_AGENT_CONTROL_URL=
VITE_BLUE_OCEAN_URL=

# Vercel Functions — server-only
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=SUBSTITUA_PELA_CHAVE_PUBLICAVEL
REALTALENT_AGENT_UPSTREAM_URL=https://runtime.seudominio.com/agent
REALTALENT_AGENT_RUNTIME_TOKEN=GERE_UM_SEGREDO_LONGO
REALTALENT_COMMUNICATIONS_UPSTREAM_URL=https://runtime.seudominio.com/communications
REALTALENT_RUNTIME_TOKEN=GERE_OUTRO_SEGREDO_LONGO
REALTALENT_PROSPECTING_UPSTREAM_URL=https://runtime.seudominio.com/prospecting
REALTALENT_PROSPECTING_RUNTIME_TOKEN=GERE_OUTRO_SEGREDO_LONGO

# Segredo do modelo fica APENAS no host persistente do Agent, nunca na Vercel frontend:
# OPENAI_API_KEY=...

# CR7 external probe (CI/operations only)
CR7_BASE_URL=https://crm.seudominio.com
CR7_SUPABASE_URL=https://SEU-PROJETO.supabase.co
CR7_SUPABASE_ANON_KEY=SUBSTITUA_PELA_CHAVE_PUBLICAVEL
