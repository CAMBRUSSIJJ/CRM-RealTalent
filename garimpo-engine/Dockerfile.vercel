FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/garimpo GARIMPO_DB=/tmp/garimpo-cache.sqlite3 \
    GARIMPO_MAPS_BINARY=/opt/garimpo-tools/google-maps-scraper-v1.19.0 \
    GARIMPO_JOB_TIMEOUT=180 GARIMPO_MAPS_TIMEOUT=90 GARIMPO_CONCURRENCY=3
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 \
    libcups2 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0 libnspr4 libnss3 \
    libpango-1.0-0 libcairo2 libx11-6 libxcb1 libxcomposite1 libxdamage1 \
    libxext6 libxfixes3 libxkbcommon0 libxrandr2 fonts-liberation \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 garimpo \
    && mkdir -p /opt/garimpo-tools && chown garimpo:garimpo /opt/garimpo-tools
WORKDIR /app
COPY pyproject.toml ./
COPY garimpo ./garimpo
COPY run-hosted.sh ./run-hosted.sh
RUN pip install --no-cache-dir .
USER garimpo
RUN python -m garimpo.cli setup-maps --directory /opt/garimpo-tools
EXPOSE 80
CMD ["sh", "/app/run-hosted.sh"]
