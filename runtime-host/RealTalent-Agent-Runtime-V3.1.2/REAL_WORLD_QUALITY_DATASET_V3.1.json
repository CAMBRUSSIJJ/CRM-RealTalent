{
  "version":"3.1",
  "purpose":"Regression dataset for perceived intelligence quality. These are deterministic routing/context/reference/tool/style checks, not a substitute for human scoring of model prose.",
  "cases":[
    {"id":"intent-01","category":"intent","message":"oi","expect":{"intent":"greeting"}},
    {"id":"intent-02","category":"intent","message":"o que é CRM?","expect":{"intent":"general_question"}},
    {"id":"intent-03","category":"intent","message":"como posso me amar?","expect":{"intent":"personal_emotional"}},
    {"id":"intent-04","category":"intent","message":"Analise o CRM inteiro e priorize o que impede a comercialização","expect":{"intent":"analysis_job"}},
