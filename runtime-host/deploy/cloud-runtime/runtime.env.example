PORT=8080
# Segredos internos — use valores diferentes e aleatórios
REALTALENT_AGENT_RUNTIME_TOKEN=gere-um-segredo-com-32-ou-mais-caracteres
REALTALENT_RUNTIME_TOKEN=gere-outro-segredo-com-32-ou-mais-caracteres
REALTALENT_PROSPECTING_RUNTIME_TOKEN=gere-outro-segredo-com-32-ou-mais-caracteres

# IA no runtime persistente
REALTALENT_AI_PROVIDER=openai
OPENAI_API_KEY=configure-no-host-persistente
OPENAI_MODEL=gpt-5.6-sol

# URLs públicas quando o runtime único estiver em https://runtime.seudominio.com
REALTALENT_COMMUNICATIONS_PUBLIC_URL=https://runtime.seudominio.com/communications
REALTALENT_PUBLIC_APP_URL=https://crm.seudominio.com

# OAuth (opcional, conforme integrações usadas)
REALTALENT_GOOGLE_CLIENT_ID=
REALTALENT_GOOGLE_CLIENT_SECRET=
REALTALENT_MICROSOFT_CLIENT_ID=
REALTALENT_MICROSOFT_CLIENT_SECRET=
REALTALENT_MICROSOFT_TENANT=common
