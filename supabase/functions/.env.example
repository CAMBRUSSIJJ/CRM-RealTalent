# Copie para supabase/functions/.env.local apenas no seu computador.
# O Supabase fornece SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY automaticamente.
AUTOMATION_CRON_SECRET=gere-uma-chave-longa-para-o-ambiente-local
# Chave de servidor restrita à Google Geocoding API para a V100.33.
GOOGLE_MAPS_API_KEY=cole-a-chave-aqui

# V100.39 — Framework de Integrações
APP_PUBLIC_URL=https://crm.exemplo.com
OAUTH_STATE_SECRET=troque-por-um-segredo-longo
INTEGRATION_TOKEN_ENCRYPTION_KEY=troque-por-uma-chave-de-32-ou-mais-caracteres
INTEGRATION_WORKER_SECRET=troque-por-um-segredo-do-worker
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=

# V100.42 — Comunicações Oficiais
COMMUNICATION_WORKER_SECRET=troque-por-um-segredo-do-worker
WHATSAPP_WEBHOOK_VERIFY_TOKEN=troque-por-um-token-de-verificacao
META_GRAPH_VERSION=v23.0
# Para push do Gmail, configure o tópico Pub/Sub no Google Cloud e associe-o à função google-communications-webhook.
GOOGLE_GMAIL_PUBSUB_TOPIC=projects/SEU-PROJETO/topics/realtalent-gmail
