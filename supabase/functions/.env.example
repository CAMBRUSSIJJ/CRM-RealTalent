# Segredos apenas no servidor.

# Garimpo com IA — configure apenas no servidor, nunca com prefixo VITE_.
# Firecrawl próprio com API v2/search e mecanismo de pesquisa (ex.: SearXNG).
# Deixe FIRECRAWL_API_URL vazio para usar a busca web da OpenAI.
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=
# Modelo com saída estruturada; para busca OpenAI, também precisa suportar web search.
PROSPECTING_AI_MODEL=
OPENAI_API_KEY=
# Opcional: endpoint HTTPS OpenAI-compatible /v1 (ex.: Ollama atrás de gateway).
# Requer Firecrawl configurado. Usa chave própria, sem encaminhar OPENAI_API_KEY.
PROSPECTING_AI_BASE_URL=
PROSPECTING_AI_API_KEY=
