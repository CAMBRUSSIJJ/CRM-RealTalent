{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src/platform/design-system/**/*.ts"
  ],
  "exclude": [
    "src/platform/design-system/**/*.test.ts",
    "src/platform/design-system/**/*.test.tsx"
  ]
}
